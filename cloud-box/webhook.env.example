# Copy to /home/box/x-bridge/webhook.env (chmod 600) and to gateway/webhook.env
GROKBOT_X_WEBHOOK_URL="https://api2.cursor.sh/automations/webhook/<YOUR_WEBHOOK_UUID>"
GROKBOT_X_WEBHOOK_AUTH="Bearer <YOUR_WEBHOOK_SECRET>"

# Optional: Cloudflare Worker relay (skip Tailscale)
# RELAY_BASE_URL="https://<your-worker>.workers.dev"
# RELAY_TOKEN="<shared-secret>"
