# Copy to /home/box/x-bridge/webhook.env (chmod 600) and to gateway/webhook.env
GROKBOT_X_WEBHOOK_URL="https://api2.cursor.sh/automations/webhook/<YOUR_WEBHOOK_UUID>"
GROKBOT_X_WEBHOOK_AUTH="Bearer <YOUR_WEBHOOK_SECRET>"

# Optional: Cloudflare Worker relay (skip Tailscale)
# RELAY_BASE_URL="https://<your-worker>.workers.dev"
# RELAY_TOKEN="<shared-secret>"

# Always-on machine gateway
CLOUD_BOX_HTTP="http://<CLOUD_TS_IP>:18082"
GATEWAY_HOST="127.0.0.1"
GATEWAY_PORT="18082"
DEFAULT_X_USER_ID="<YOUR_X_USER_ID>"
DEFAULT_X_USERNAME="<YOUR_X_USERNAME>"
DEFAULT_X_DISPLAY_NAME="<YOUR_DISPLAY_NAME>"

# Cold-start behaviour for MCP tools/call
GROKBOT_X_INLINE_WAIT="40"
GROKBOT_X_COLD_TIMEOUT="360"
GROKBOT_X_RESULT_TTL="600"
GROKBOT_X_HEALTH_TIMEOUT="2"

# If set, gateway polls RELAY_BASE_URL/response/<id> instead of CLOUD_BOX_HTTP
# RELAY_BASE_URL="https://<your-worker>.workers.dev"
# RELAY_TOKEN="<shared-secret>"
